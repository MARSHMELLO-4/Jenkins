pipeline {

    agent any

    options {
        skipDefaultCheckout(true)
    }

    environment {
        APP_DIR = 'BasicCalculator/BasicCalculator'
    }

    stages {

        stage('Checkout') {
            steps {
                checkout scm
            }
        }

        stage('Compile') {
            steps {
                dir("${APP_DIR}") {
                    sh './mvnw -B -DskipTests compile'
                }
            }
        }

        stage('Tests') {
            steps {
                dir("${APP_DIR}") {
                    sh './mvnw -B test'
                }
            }

            post {
                always {
                    junit "${APP_DIR}/target/surefire-reports/*.xml"
                }
            }
        }

        stage('Package') {
            steps {
                dir("${APP_DIR}") {
                    sh './mvnw -B -DskipTests package'

                    archiveArtifacts artifacts: 'target/*.jar',
                                     fingerprint: true
                }
            }
        }

        stage('Deploy') {
            when {
                branch 'main'
            }

            steps {
                dir("${APP_DIR}") {
                    sh '''
                        set -e

                        DEPLOY_ROOT=/opt/cicd-demo/spring
                        RELEASE_DIR="$DEPLOY_ROOT/releases/$BUILD_NUMBER"

                        rm -rf "$RELEASE_DIR"
                        mkdir -p "$RELEASE_DIR"

                        JAR_FILE=$(find target \
                            -maxdepth 1 \
                            -type f \
                            -name '*.jar' \
                            | head -1)

                        if [ -z "$JAR_FILE" ]; then
                            echo "ERROR: No JAR file found"
                            exit 1
                        fi

                        cp "$JAR_FILE" \
                           "$RELEASE_DIR/app.jar"

                        if [ -f "$DEPLOY_ROOT/app.pid" ]; then

                            OLD_PID=$(cat "$DEPLOY_ROOT/app.pid" || true)

                            if [ -n "$OLD_PID" ] && \
                               kill -0 "$OLD_PID" 2>/dev/null; then

                                echo "Stopping old application: PID $OLD_PID"

                                kill "$OLD_PID" || true

                                sleep 3
                            fi
                        fi

                        echo "Starting application..."

                        JENKINS_NODE_COOKIE=dontKillMe \
                        APP_VERSION="$BUILD_NUMBER" \
                        nohup java \
                        -jar "$RELEASE_DIR/app.jar" \
                        > "$DEPLOY_ROOT/app.log" 2>&1 &

                        echo $! > "$DEPLOY_ROOT/app.pid"

                        echo "Application started with PID $(cat "$DEPLOY_ROOT/app.pid")"
                    '''
                }
            }
        }

        stage('Smoke Test') {
            when {
                branch 'main'
            }

            steps {
                sh '''
                    sleep 5

                    curl -f http://127.0.0.1:8082/api/health

                    echo "Smoke test passed"
                '''
            }
        }
    }

    post {

        success {
            echo 'SPRING PIPELINE SUCCESSFUL'
        }

        failure {
            echo 'SPRING PIPELINE FAILED'
        }
    }
}